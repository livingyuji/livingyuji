# ====================================================================
# LivingYuji OS — Environment Variables Configuration
# ====================================================================

# 1. Supabase Cloud Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Supabase Service Role Key (Server-side administration & webhooks only. NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Administrator Access & Cryptographic Signing
# Used for server-side verification of the desktop Control Panel and /admin/dashboard
ADMIN_ACCESS_PASSPHRASE=your-secure-admin-passphrase-here
ADMIN_SESSION_SECRET=your-random-32-char-hmac-secret-here

# 3. Discord Purchasing & Community Links (Configurable via Admin Control Panel)
NEXT_PUBLIC_DISCORD_SERVER_URL=https://discord.gg/livingyuji
